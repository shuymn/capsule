{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>shuymn/github-actions#main"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the git-cliff candidate generator",
      "managerFilePatterns": ["/^\\.github/workflows/release-pr\\.yml$/"],
      "matchStrings": ["git-cliff@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "git-cliff",
      "datasourceTemplate": "crate",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update uv installed by CI",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["tool: uv@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ]
}
