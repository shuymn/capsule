{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>shuymn/github-actions#main"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the git-cliff candidate generator",
      "managerFilePatterns": ["/^\\.github/workflows/release-pr\\.yml$/"],
      "matchStrings": ["git-cliff@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "git-cliff",
      "datasourceTemplate": "crate",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the cargo-mutants pin of the opt-in mise task",
      "managerFilePatterns": ["/^mise\\.toml$/"],
      "matchStrings": ["\"github:sourcefrog/cargo-mutants\" = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "sourcefrog/cargo-mutants",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the mise version that workflows pass to jdx/mise-action",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["CI_MISE_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Move CI and the Linux helper image to the same mise release",
      "matchDepNames": ["jdx/mise", "ghcr.io/jdx/mise"],
      "groupName": "mise"
    }
  ]
}
